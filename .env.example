# =============================================================================
# PHOSARA AI Sales Agent — 環境変数テンプレート
#
# 使い方:
#   cp .env.example .env
#   .env を開いて実際の値を設定する
#
# 注意:
#   .env は絶対に Git にコミットしない（.gitignore に含まれている）
#   このファイル（.env.example）はコミットしてよい（値を入れない）
# =============================================================================

# =============================================================================
# [任意] Anthropic API Key
# claude.ai OAuth 認証（Pro/Max サブスクリプション）を使用する場合は不要
# API Key 直接利用（CI/CD・サーバー環境など）の場合のみ設定
# 取得先: https://console.anthropic.com/settings/keys
# =============================================================================
ANTHROPIC_API_KEY=

# =============================================================================
# [必須] GitHub — MCP github サーバー / Webhook 認証
# 取得先: GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
# 必要な権限:
#   - Contents: Read and write
#   - Metadata: Read-only（自動付与）
# =============================================================================
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your-token-here
GITHUB_REPO_OWNER=PHOSARA01
GITHUB_REPO_NAME=phosara
GITHUB_BRANCH=main

# =============================================================================
# [必須] Brave Search — 企業 Web 調査
# 取得先: https://api.search.brave.com/
# 料金: Free プランで月 2,000 クエリ（Phase 1 は十分）
# =============================================================================
BRAVE_SEARCH_API_KEY=BSA-your-key-here

# =============================================================================
# [必須] n8n — ワークフロー自動化
# セルフホストの場合: npm install -g n8n && n8n start
# =============================================================================
N8N_HOST=http://localhost:5678
N8N_WEBHOOK_SECRET=change-this-to-a-random-secret-string

# =============================================================================
# [推奨] 通知設定
# =============================================================================
# オーナーのメールアドレス（Gmail 承認通知の送信先）
OWNER_EMAIL=your-email@example.com

# =============================================================================
# [推奨] AI Agent 動作設定
# =============================================================================
# 1回の朝バッチで処理するターゲット数（Phase 1 は 1 固定）
SALES_AGENT_MAX_TARGETS_PER_RUN=1

# 承認キュー登録の最低 Confidence Score（%）
SALES_AGENT_CONFIDENCE_THRESHOLD=70

# 承認 SLA（時間）
SALES_AGENT_APPROVAL_SLA_HOURS=48

# =============================================================================
# [Phase 2 以降] 追加予定
# =============================================================================
# Gmail API（営業メール送信用）— Phase 2
# GMAIL_OAUTH_TOKEN=

# Google Calendar API（Business Audit 予約）— Phase 3
# GOOGLE_CALENDAR_TOKEN=

# Google Drive API（ナレッジ管理）— Phase 2
# GOOGLE_DRIVE_TOKEN=

# Slack 通知（Gmail の代替）— Phase 2 オプション
# SLACK_WEBHOOK_URL=
