{
  "mcpServers": {
    "filesystem": {
      "command": "node",
      "args": [
        "/Users/hiwatarishouta/.local/npm-global/bin/mcp-server-filesystem",
        "__REPO_ROOT__"
      ],
      "description": "ローカル Markdown ファイルの読み書き（REPO_ROOT は scripts/morning-batch.sh が実行時に差し替える）"
    },
    "github": {
      "command": "node",
      "args": [
        "/Users/hiwatarishouta/.local/npm-global/bin/mcp-server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "__GITHUB_PERSONAL_ACCESS_TOKEN__"
      },
      "description": "GitHub コミット・ファイル読み込み"
    },
    "brave-search": {
      "command": "node",
      "args": [
        "/Users/hiwatarishouta/.local/npm-global/bin/mcp-server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "__BRAVE_SEARCH_API_KEY__"
      },
      "description": "企業 Web 調査（最大 5 クエリ / ターゲット）"
    },
    "fetch": {
      "command": "node",
      "args": [
        "/Users/hiwatarishouta/.local/npm-global/bin/mcp-server-fetch"
      ],
      "description": "企業公式サイトのページ取得（公開情報のみ）"
    }
  }
}
