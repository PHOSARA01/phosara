# .env.example — 環境変数テンプレート
#
# このファイルはリポジトリに含める安全なテンプレートです。
# 実際の値を .env ファイルにコピーして使用してください。
# .env はコミット禁止。.gitignore に必ず含めること。
#
# 参照: HUMAN_APPROVAL.md §「セキュリティ原則」
# 参照: DIRECTORY_STRUCTURE.md §「ファイル命名規則」
#
# 管理: PHOSARA HQ
# 更新: 新ツール追加・キー変更のたびに更新する
#

# =============================================================================
# AI / LLM
# =============================================================================

# Anthropic API — Claude Code / AI 従業員が使用
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# GitHub
# =============================================================================

# GitHub Personal Access Token — リポジトリ操作・Actions 連携
GITHUB_TOKEN=your_github_token_here

# リポジトリ情報（ハードコードせず環境変数で管理）
GITHUB_REPO_OWNER=PHOSARA01
GITHUB_REPO_NAME=phosara

# =============================================================================
# n8n（Phase 2 以降）
# =============================================================================

# n8n インスタンス URL（セルフホスト or クラウド）
N8N_BASE_URL=https://your-n8n-instance.example.com

# n8n API キー
N8N_API_KEY=your_n8n_api_key_here

# Webhook エンドポイント（AI 従業員ごとに 1 つ）
N8N_WEBHOOK_SALES=https://your-n8n-instance.example.com/webhook/sales
N8N_WEBHOOK_CLIENT_SUCCESS=https://your-n8n-instance.example.com/webhook/client-success
N8N_WEBHOOK_KNOWLEDGE=https://your-n8n-instance.example.com/webhook/knowledge
N8N_WEBHOOK_PBOS=https://your-n8n-instance.example.com/webhook/pbos
N8N_WEBHOOK_CEO=https://your-n8n-instance.example.com/webhook/ceo

# =============================================================================
# MCP（Model Context Protocol）（Phase 2 以降）
# =============================================================================

# MCP サーバー URL（Claude Code が AI 従業員のコンテキストを取得する先）
MCP_SERVER_URL=https://your-mcp-server.example.com

# MCP 認証トークン
MCP_AUTH_TOKEN=your_mcp_auth_token_here

# =============================================================================
# 通知（Phase 1 以降）
# =============================================================================

# オーナーへの通知先（Slack / メール / LINE 等）
# WAITING_APPROVAL・エスカレーション・Daily CEO Brief の送信先

# Slack（オプション）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
SLACK_CHANNEL_APPROVALS=#phosara-approvals
SLACK_CHANNEL_CEO_BRIEF=#phosara-ceo-brief

# メール（オプション）
NOTIFICATION_EMAIL=your_notification_email@example.com

# =============================================================================
# ログ設定
# =============================================================================

# ログの保存先（GitHub リポジトリ内パス）
LOG_BASE_PATH=company/13_ai-company/implementation/logs

# ログのタイムゾーン
LOG_TIMEZONE=Asia/Tokyo

# =============================================================================
# セキュリティ設定
# =============================================================================

# 環境識別子（本番 / 開発 / テスト）
PHOSARA_ENV=development

# 機密情報の保存先（顧客データを含むディレクトリは公開領域と分離すること）
# 例: GitHub の private リポジトリ or 別の安全な保存場所
CLIENT_DATA_STORE=private

# =============================================================================
# Phase 3 以降（現時点では未使用）
# =============================================================================

# KPI ダッシュボード（Phase 3）
DASHBOARD_URL=https://your-dashboard.example.com
DASHBOARD_API_KEY=your_dashboard_api_key_here

# 外部データソース（Phase 3）
ANALYTICS_API_KEY=your_analytics_api_key_here
